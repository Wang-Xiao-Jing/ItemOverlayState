{
  "schemaVersion": 1,
  "id": "itemoverlaystate",
  "version": "${version}",
  "name": "Item Overlay State",
  "description": "Expand original item coverage predicate",
  "authors": [
    "XiaoJin"
  ],
  "contact": {
    "modUrl": "https://xiao-jin-mod-wiki.netlify.app/mod/itemoverlaystate/"
  },
  "license": "MIT",
  "icon": "pack.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
    ],
